# Text files are stored and checked out with LF on every platform.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.pdf binary
*.png binary
*.jpg binary
*.wav binary
*.onnx binary
*.pt binary
*.safetensors binary
*.gz binary
